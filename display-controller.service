[Unit]
Description=Pin rig SPI display device
After=local-fs.target network.target

[Service]
Type=simple
User=pinrigdisplay
Group=pinrigdisplay
SupplementaryGroups=spi gpio dialout
ExecStart=/opt/pinrig-device/bin/display-controller --config /etc/pinrig-display.toml
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
StateDirectory=display-controller
StateDirectoryMode=0750
RuntimeDirectory=display-controller
RuntimeDirectoryMode=0750
Environment=LG_WD=/run/display-controller
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
