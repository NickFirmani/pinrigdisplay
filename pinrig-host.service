[Unit]
Description=Pin rig HTTP to USB display host
After=network.target

[Service]
Type=simple
User=pinrig
Group=pinrig
SupplementaryGroups=dialout
EnvironmentFile=/etc/pinrig-host.env
ExecStart=/opt/pinrig-host/bin/pinrig-host --serial ${PINRIG_SERIAL} --bind ${PINRIG_BIND}
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=pinrig-host
StateDirectoryMode=0750
UMask=0027

[Install]
WantedBy=multi-user.target
